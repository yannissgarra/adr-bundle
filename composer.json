{
    "name": "webmunkeez/adr-bundle",
    "type": "symfony-bundle",
    "description": "Action-Domain-Responder pattern made for Symfony.",
    "keywords": [
        "symfony",
        "controllers",
        "action",
        "autowiring",
        "responder",
        "templates"
    ],
    "homepage": "https://github.com/yannissgarra/adr-bundle",
    "license": "MIT",
    "authors": [
        {
            "name": "Yannis Sgarra",
            "email": "hello@yannissgarra.com",
            "homepage": "https://yannissgarra.com"
        }
    ],
    "require": {
        "php": ">=8.2",
        "phpdocumentor/reflection-docblock": "^6.0",
        "symfony/config": "^7.4",
        "symfony/dependency-injection": "^7.4",
        "symfony/expression-language": "^7.4",
        "symfony/http-foundation": "^7.4",
        "symfony/http-kernel": "^7.4",
        "symfony/property-access": "^7.4",
        "symfony/property-info": "^7.4",
        "symfony/serializer": "^7.4",
        "twig/twig": "^3"
    },
    "require-dev": {
        "friendsofphp/php-cs-fixer": "^3",
        "phpstan/phpstan": "^2",
        "phpstan/phpstan-symfony": "^2",
        "phpstan/phpstan-deprecation-rules": "^2",
        "phpunit/phpunit": "^11",
        "symfony/browser-kit": "^7.4",
        "symfony/css-selector": "^7.4",
        "symfony/framework-bundle": "^7.4",
        "symfony/phpunit-bridge": "^7.4",
        "symfony/twig-bundle": "^7.4",
        "symfony/uid": "^7.4",
        "symfony/yaml": "^7.4"
    },
    "autoload": {
        "psr-4": {
            "Webmunkeez\\ADRBundle\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Webmunkeez\\ADRBundle\\Test\\": "tests/"
        }
    },
    "extra": {
        "branch-alias": {
            "dev-main": "3.0.x-dev"
        }
    }
}
